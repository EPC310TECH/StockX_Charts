# Copy this file to .env and fill in your own keys. .env is gitignored --
# never commit real credentials.

# Alpaca (free tier, IEX feed) -- sign up at https://alpaca.markets, create
# a paper trading account (no funding needed), then generate an API key
# under "API Keys" in the dashboard. Used as the default tick/quote source.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Databento (pay-as-you-go, $125 free credit for new accounts) -- sign up
# at https://databento.com, generate a key under Portal > API Keys. Only
# called when a fetch explicitly requests source="databento", since every
# pull draws down the credit.
DATABENTO_API_KEY=
